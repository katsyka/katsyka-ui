  ["hero-product","Perspective Product Hero","Heroes","A dashboard mock that lies tilted in 3D and stands up as you scroll, with a pointer-driven parallax.",["3d","scroll","product"]],
  ["nav-pill","Floating Pill Nav","Navigation","Detached navbar that compacts on scroll, with a springy indicator that follows the hovered link.",["navbar","indicator","scroll"]],
  ["dock","Magnifying Dock","Navigation","Icon dock with smooth distance-based magnification, tooltips and active dots.",["dock","pointer","spring"]],
  ["buttons","Button Kit","Buttons","Four buttons: rotating conic border, magnetic pull, liquid fill wipe and a press-to-confirm hold.",["buttons","magnetic","micro-interaction"]],
  ["bento","Spotlight Bento","Cards","Feature bento grid where a soft light follows the pointer across card borders, with live mini-visuals inside.",["bento","spotlight","features"]],
  ["beams","Animated Beams","Cards","Integration diagram with SVG beams that carry pulses from source nodes into a central hub.",["svg","diagram","integrations"]],
  ["tilt-card","Holo Tilt Card","Cards","A physical-feeling card that tilts in 3D with a moving glare and holographic foil.",["3d","card","glare"]],
  ["text-effects","Text Effects","Text","Scramble decode, rotating word slot, gradient sweep and a stroke-to-fill headline.",["typography","scramble","rotate"]],
  ["signin","Sign-in Card","Forms","Floating labels, password reveal, a 4-segment strength meter and a loading-to-success submit.",["auth","validation","form"]],
  ["otp","OTP Input","Forms","Six-cell one-time code field with paste support, auto-advance, caret and shake on error.",["otp","input","verification"]],
  ["waitlist","Waitlist Morph","Forms","An email field whose button morphs through loading into a confirmed state, with a counter tick.",["email","morph","success"]],
  ["pricing","Pricing Toggle","Pricing","Three tiers with a sliding monthly/yearly switch and digits that roll to the new price.",["pricing","toggle","number roll"]],
  ["testimonials","Testimonial Columns","Testimonials","Three vertical marquees at different speeds with edge fade, pausing on hover.",["marquee","social proof"]],
  ["logos","Logo Marquee","Sections","Infinite logo strip with masked edges, hover pause and a lift on each mark.",["marquee","logos"]],
  ["faq","Smooth FAQ","Sections","Accordion that animates real height with grid rows, plus a rotating plus icon.",["accordion","faq"]],
  ["cmdk","Command Palette","Overlays","⌘K palette with fuzzy filtering, grouped results, keyboard navigation and a sliding highlight.",["command","keyboard","search"]],
  ["toasts","Stacked Toasts","Overlays","Notifications that stack into a deck and fan out on hover, with swipe-free dismiss and timers.",["toast","stack","notification"]],
  ["footer-wordmark","Wordmark Footer","Footers","Link columns over a huge cropped wordmark that fills in under the pointer.",["footer","wordmark","mask"]],
  ["footer-locale","Locale Footer","Footers","Light multi-column footer with a working region and currency picker that opens upward.",["footer","locale","currency","listbox"],1],
  ["footer-atelier","Atelier Footer","Footers","Editorial serif footer with a hairline newsletter field that validates and confirms.",["footer","newsletter","serif","editorial"],1],
  ["footer-contact","Contact Footer","Footers","Studio footer led by a big email link, copy button, live local time and a ghosted wordmark.",["footer","contact","agency","wordmark"],1],
  ["footer-swiss","Swiss Grid Footer","Footers","Strict 1px black grid with numbered cells and ruled link lists.",["footer","swiss","grid","minimal"],1],
  ["footer-journal","Journal Footer","Footers","Warm linen footer with a rounded newsletter card and serif brand.",["footer","newsletter","organic","shop"],1],
].map(([id,name,cat,desc,tags,isNew],i)=>({id,name,cat,desc,tags,isNew,i}));

const FONTS = '<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300..800&family=Geist+Mono:wght@400;500&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet">';
const RESET = "*,*::before,*::after{box-sizing:border-box}html,body{margin:0}body{font-family:Geist,system-ui,sans-serif;background:#09090b;color:#fafafa;-webkit-font-smoothing:antialiased}";
const cache = {}, TV = 21;
async function load(id){
  if(!cache[id]){
    const src = await (await fetch(`components/${id}.html?v=24`)).text();
    const css = (src.match(/<style>([\s\S]*?)<\/style>/)||[,""])[1].trim();
    const js = (src.match(/<script>([\s\S]*?)<\/script>/)||[,""])[1].trim();
    const html = src.replace(/<style>[\s\S]*?<\/style>/,"").replace(/<script>[\s\S]*?<\/script>/,"").trim();
    const full = `<!doctype html>\n<html lang="en">\n<head>\n<meta charset="utf-8">\n<meta name="viewport" content="width=device-width,initial-scale=1">\n${FONTS}\n<style>\n${RESET}\n${css}\n</style>\n</head>\n<body>\n${html}\n${js?`<script>\n${js}\n</script>\n`:""}</body>\n</html>`;
    cache[id] = {html,css,js,full};
  }
  return cache[id];
}

if (document.currentScript && document.currentScript.hasAttribute("data-view")) {
  load(location.hash.slice(1)).then(c=>{document.open();document.write(c.full);document.close();});
} else ui();

function ui(){
const $ = s=>document.querySelector(s);
$("#count").textContent = C.length; $("#catN").textContent = new Set(C.map(c=>c.cat)).size;
const ORDER = ["Mobile","Dark","Backgrounds","Images","Custom","Video","Shaders","Heroes","AI","Navigation","Forms","Data","Cards","Overlays","Feedback","Display","Text","Sections","Buttons","Pricing","Testimonials","Footers"];
const ALLCATS = [...ORDER.filter(k=>C.some(c=>c.cat===k)), ...[...new Set(C.map(c=>c.cat))].filter(k=>!ORDER.includes(k))];
const DESC = {Mobile:"Phone screens built to mobile rules: 16px gutters, 44px targets, safe areas, thumb-reach actions and a liquid glass tab bar.",Dark:"Dark mode done properly: lifted surfaces, tuned accents, checked contrast.",Images:"Photo galleries and image effects.",Custom:"Inventive controls with full keyboard, ARIA and light/dark support.",Video:"Built around generated video loops and frame sequences.",Shaders:"Real-time GPU and canvas pieces.",Heroes:"Opening sections with a strong idea.",AI:"Prompting, voice and assistant UI.",Navigation:"Bars, menus and sidebars.",Forms:"Inputs, wizards and pickers that validate properly.",Data:"Charts, tables and boards.",Cards:"Interactive cards and media.",Overlays:"Dialogs, menus, sheets and popovers.",Feedback:"Alerts, progress, loading and empty states.",Display:"Badges, avatars, lists, code and content blocks.",Text:"Typographic effects.",Sections:"Page sections ready to drop in.",Buttons:"Pressable things.",Pricing:"Plans and calculators.",Testimonials:"Social proof.",Footers:"Page endings."};
const cats = ["All","New",...ALLCATS];
const inCat = k=>C.filter(c=>k==="All"||c.cat===k||(k==="New"&&c.isNew));
let cat = "All";

// thumbnails: static screenshots; the live component mounts only while hovered
const ro = new ResizeObserver(es=>es.forEach(e=>size(e.target)));
const size = t=>t.style.setProperty("--s", Math.max(t.clientWidth/1200, t.clientHeight/750));
const cardHTML = c=>`<a class="card" href="${c.id}"><div class="thumb" data-id="${c.id}"><img src="thumbs/${c.id}.jpg?v=${TV}" alt="" loading="lazy">${c.isNew?'<span class="new">NEW</span>':""}</div><div class="meta"><b>${c.name}</b><span>${c.cat}</span></div></a>`;
const mount = el=>el.querySelectorAll(".thumb").forEach(t=>{
  ro.observe(t); let tm;
  t.onpointerenter = ()=>{ tm = setTimeout(()=>load(t.dataset.id).then(c=>{
    if (!t.matches(":hover") || t.querySelector("iframe")) return;
    const fr = document.createElement("iframe"); fr.tabIndex=-1; fr.srcdoc=c.full;
    fr.onload = ()=>fr.classList.add("on"); t.append(fr); size(t);
  }),220); };
  t.onpointerleave = ()=>{ clearTimeout(tm); t.querySelector("iframe")?.remove(); };
});
function renderFilters(){
  $("#filters").innerHTML = cats.map(k=>`<a href="${k==="All"?"./":"category/"+k.toLowerCase()}" class="${k===cat?"on":""}${k==="New"||k==="Custom"?" hot":""}"${k===cat?' aria-current="page"':""}>${k}<span>${inCat(k).length}</span></a>`).join("");
}
const PICK = {Backgrounds:["iridescent-shapes","impressionist-painting","dithered-image"],Images:["portrait-reveal","liquid-hover","tile-flip"],Feedback:["upload-list","alerts","skeletons"],Display:["code-block","comment-thread","avatars"],Buttons:["button-kit","async-button","speed-dial"],Custom:["gradient-editor","oklch-picker","image-cropper"],Video:["descent-hero","storm-window","aurora-stay"],Heroes:["hero-kinetic","hero-editorial","hero-aurora"],Navigation:["mega-menu","dock","nav-pill"],Forms:["onboarding","waitlist","combobox"],Data:["kanban","data-table","heatmap"],Cards:["swipe-deck","compare-slider","music-player"],Overlays:["cookie-consent","bottom-sheet","modal-zoom"],Sections:["changelog","feature-tabs","faq"],Text:["link-preview","proximity-type","text-effects"],Shaders:["grain-glass","shader-gradient","liquid-chrome"]};
function renderCats(){
  $("#cats").innerHTML = ALLCATS.map(k=>{const L=inCat(k);return `<a class="ct${L.some(c=>c.isNew)?" hot":""}" href="category/${k.toLowerCase()}"><div class="ct-im">${(PICK[k]?PICK[k].map(id=>({id})):L.slice(0,3)).map(c=>`<img src="thumbs/${c.id}.jpg?v=${TV}" alt="" loading="lazy">`).join("")}</div><b>${k}</b><span>${L.length} component${L.length>1?"s":""}</span></a>`}).join("");
}
function renderGrid(){
  const g = $("#grid");
  g.querySelectorAll(".thumb").forEach(t=>ro.unobserve(t));
  if (cat==="All") g.innerHTML = ALLCATS.map(k=>`<section class="cs hl" id="cs-${k}"><header class="cs-h"><h3>${k}</h3><span>${inCat(k).length}</span><p>${DESC[k]||""}</p><a href="category/${k.toLowerCase()}">Only ${k} →</a></header><div class="grid">${inCat(k).map(cardHTML).join("")}</div></section>`).join("");
  else g.innerHTML = `<header class="cv-h"><a href="./">← All categories</a><h2>${cat}<span>${inCat(cat).length}</span></h2><p>${cat==="New"?"Added in the latest release.":DESC[cat]||""}</p></header><div class="grid">${inCat(cat).map(cardHTML).join("")}</div>`;
  mount(g);
}

// detail
let cur, tab = "full";
const frame = $("#frame");
async function show(id){
  const c = C.find(x=>x.id===id); if(!c) return nav("./",1);
  cur = c;
  $("#dCat").textContent = c.cat; $("#dName").textContent = c.name;
  const sib = inCat(c.cat), si = sib.indexOf(c), pv = sib[(si-1+sib.length)%sib.length], nx2 = sib[(si+1)%sib.length];
  $("#dCatL").textContent = c.cat; $("#dCatL").href = "category/"+c.cat.toLowerCase(); $("#dCrumb").textContent = c.name;
  $("#dPrev").href = pv.id; $("#dPrev span").textContent = pv.name; $("#dPrev").title = "Previous in "+c.cat;
  $("#dNext").href = nx2.id; $("#dNext span").textContent = nx2.name; $("#dNext").title = "Next in "+c.cat; $("#dDesc").textContent = c.desc;
  $("#dTags").innerHTML = c.tags.map(t=>`<span>${t}</span>`).join("");
  $("#openNew").href = "view.html#"+id;
  document.title = c.name+" — Katsyka UI";
  const d = await load(id);
  frame.srcdoc = withScheme(d.full);
  [...$("#tabs").children].forEach(b=>{ if(b.dataset.t) b.hidden = b.dataset.t!=="full" && !d[b.dataset.t]; });
  setTab(tab==="js"&&!d.js?"full":tab);
  const nx = $("#next");
  nx.querySelectorAll(".thumb").forEach(t=>ro.unobserve(t));
  nx.innerHTML = [1,2,3].map(k=>C[(c.i+k)%C.length]).map(cardHTML).join(""); mount(nx);
}
function setTab(t){
  tab = t;
  const btns = [...$("#tabs").querySelectorAll("button")], b = btns.find(x=>x.dataset.t===t);
  btns.forEach(x=>x.classList.toggle("on",x===b));
  const p = $("#tabs .pill"); p.style.left = b.offsetLeft+"px"; p.style.width = b.offsetWidth+"px";
  const d = cache[cur.id], el = $("#codeEl");
  el.textContent = d[t]; el.className = "language-"+(t==="css"?"css":t==="js"?"javascript":"xml");
  if (window.hljs) { delete el.dataset.highlighted; hljs.highlightElement(el); }
}
$("#tabs").onclick = e=>{const b=e.target.closest("button"); if(b) setTab(b.dataset.t)};
$("#vp").onclick = e=>{const b=e.target.closest("button"); if(!b)return;
  $("#vp").querySelectorAll("button").forEach(x=>x.classList.toggle("on",x===b));
  frame.style.width = b.dataset.w; frame.classList.toggle("narrow",b.dataset.w!=="100%");};
let scheme="auto";
const withScheme = h=>scheme==="auto"?h:h.replace("</head>",`<style>*{color-scheme:${scheme}!important}</style></head>`);
$("#reload").onclick = ()=>{frame.srcdoc = withScheme(cache[cur.id].full)};
$("#scheme").onclick = ()=>{scheme={auto:"light",light:"dark",dark:"auto"}[scheme];$("#scheme").dataset.s=scheme;$("#scheme").title="Preview theme: "+scheme;frame.srcdoc=withScheme(cache[cur.id].full)};
const toast = m=>{const t=$("#toast"); t.textContent=m; t.classList.add("on"); clearTimeout(t._t); t._t=setTimeout(()=>t.classList.remove("on"),1600)};
$("#copy").onclick = async ()=>{
  const txt = cache[cur.id][tab];
  try { await navigator.clipboard.writeText(txt); }
  catch { const a=document.createElement("textarea"); a.value=txt; document.body.appendChild(a); a.select(); document.execCommand("copy"); a.remove(); }
  toast("Copied "+(tab==="full"?"index.html":tab.toUpperCase()));
};
const MCP_URL = "https://ui.katsyka.dev/mcp", MCP = {
  cc: `claude mcp add --transport http katsyka-ui ${MCP_URL}`,
  claude: `Settings → Connectors → Add custom connector\n\nName: Katsyka UI\nURL:  ${MCP_URL}`,
  cursor: `// ~/.cursor/mcp.json\n{\n  "mcpServers": {\n    "katsyka-ui": { "url": "${MCP_URL}" }\n  }\n}`,
  vscode: `// .vscode/mcp.json\n{\n  "servers": {\n    "katsyka-ui": { "type": "http", "url": "${MCP_URL}" }\n  }\n}`,
  chatgpt: `Settings → Apps & Connectors → Advanced → Developer mode\nThen: Create → name "Katsyka UI", URL ${MCP_URL}, no auth`,
};
const mcpShow = k=>{ $("#mcpSnip").textContent = MCP[k]; document.querySelectorAll("#mcpTabs button").forEach(b=>b.classList.toggle("on",b.dataset.m===k)); };
$("#mcpTabs").onclick = e=>{ const b=e.target.closest("button"); if(b) mcpShow(b.dataset.m); };
document.querySelectorAll("[data-copy]").forEach(b=>b.onclick = async ()=>{
  const txt = $(b.dataset.copy).textContent;
  try { await navigator.clipboard.writeText(txt); }
  catch { const a=document.createElement("textarea"); a.value=txt; document.body.appendChild(a); a.select(); document.execCommand("copy"); a.remove(); }
  toast("Copied");
});
mcpShow("cc");
$("#dl").onclick = ()=>{
  const a = document.createElement("a");
  a.href = URL.createObjectURL(new Blob([cache[cur.id].full],{type:"text/html"}));
  a.download = cur.id+".html"; a.click(); setTimeout(()=>URL.revokeObjectURL(a.href),2000);
};

// router
const BASE = new URL(document.baseURI).pathname;
function route(){
  // clean paths relative to <base>: "", about, mcp, category/<name>, <component-id>
  const rel = decodeURIComponent(location.pathname.slice(BASE.length)).replace(/\/$/,"");
  const h = rel===""?"#/":rel==="about"||rel==="mcp"?"#/"+rel:rel.startsWith("category/")?"#/cat/"+(cats.find(k=>k.toLowerCase()===rel.slice(9))||"All"):"#/c/"+rel;
  const m = h.match(/^#\/c\/([\w-]+)/), mc = h.match(/^#\/cat\/(.+)$/), view = m?"detail":h==="#/about"?"about":h==="#/mcp"?"mcp":"home";
  if (view==="home") { const nc = mc?decodeURIComponent(mc[1]):"All"; const changed = nc!==cat || !$("#grid").innerHTML; cat = cats.includes(nc)?nc:"All"; if (changed){ renderFilters(); renderGrid(); }
    if (mc) requestAnimationFrame(()=>scrollTo({top:$("#browse").offsetTop+$("#browse").offsetHeight-64,behavior:changed?"instant":"smooth"})); }
  ["home","detail","about","mcp"].forEach(v=>$("#"+v).hidden = v!==view);
  document.querySelectorAll("[data-nav]").forEach(a=>a.classList.toggle("on",a.dataset.nav===view||(view==="detail"&&a.dataset.nav==="home")));
  if (m) { show(m[1]); scrollTo(0,0); } else { frame.srcdoc=""; document.title=(view==="home"&&cat!=="All"?cat+" — ":"")+"Katsyka UI — copy-paste UI components"; if(view!=="home"||!mc&&h==="#/")scrollTo(0,0); }
}
addEventListener("popstate",route);
function nav(to, replace){ const u = new URL(to, document.baseURI);
  if (u.pathname!==location.pathname){ history[replace?"replaceState":"pushState"](null,"",u.pathname); route(); }
  if (typeof menu==="function") menu(false); }
document.addEventListener("click",e=>{ const a=e.target.closest("a[href]"); if(!a||e.defaultPrevented||e.button||e.metaKey||e.ctrlKey||e.shiftKey||e.altKey||a.target||a.hasAttribute("download"))return;
  const raw=a.getAttribute("href");
  if(raw.startsWith("#")){ const t=document.getElementById(raw.slice(1)); if(t){ e.preventDefault(); t.scrollIntoView({behavior:"smooth"}); } return; }
  const u=new URL(a.href); if(u.origin!==location.origin||!u.pathname.startsWith(BASE)||/\.\w+$/.test(u.pathname))return;
  e.preventDefault(); nav(u.pathname); });
const top_ = $(".top"), menuBtn = $("#menuBtn");
const menu = open=>{ top_.classList.toggle("open",open); menuBtn.setAttribute("aria-expanded",open); };
menuBtn.onclick = ()=>menu(!top_.classList.contains("open"));
addEventListener("keydown",e=>{ if(e.key==="Escape") menu(false); });
addEventListener("keydown",e=>{ if($("#detail").hidden||!$("#k").hidden||e.metaKey||e.ctrlKey||e.altKey||/INPUT|TEXTAREA/.test(document.activeElement.tagName))return;
  if(e.key==="ArrowLeft")nav($("#dPrev").getAttribute("href")); if(e.key==="ArrowRight")nav($("#dNext").getAttribute("href")); });

// ⌘K
const k=$("#k"), kIn=$("#kIn"), kList=$("#kList"); let kSel=0, kRes=[];
const openK = ()=>{k.hidden=false; kIn.value=""; kFilter(); kIn.focus();};
const closeK = ()=>k.hidden=true;
function kFilter(){
  const q = kIn.value.toLowerCase().trim();
  kRes = C.filter(c=>!q||(c.name+" "+c.cat+" "+c.tags.join(" ")+" "+c.desc).toLowerCase().includes(q));
  kSel = 0; kDraw();
}
function kDraw(){
  kList.innerHTML = kRes.length ? kRes.map((c,i)=>`<li class="${i===kSel?"on":""}" data-i="${i}">${c.name}<span>${c.cat}</span></li>`).join("") : '<li class="empty">Nothing matches.</li>';
  kList.querySelector(".on")?.scrollIntoView({block:"nearest"});
}
const kGo = ()=>{ if(kRes[kSel]){ nav(kRes[kSel].id); closeK(); } };
kIn.oninput = kFilter;
kList.onmousemove = e=>{const l=e.target.closest("li[data-i]"); if(l&&+l.dataset.i!==kSel){kSel=+l.dataset.i;kDraw();}};
kList.onclick = kGo;
k.onclick = e=>{ if(e.target===k) closeK(); };
$("#openK").onclick = openK;
addEventListener("keydown",e=>{
  if ((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==="k"){e.preventDefault(); k.hidden?openK():closeK(); return;}
  if (e.key==="/"&&k.hidden&&!/INPUT|TEXTAREA/.test(document.activeElement.tagName)){e.preventDefault(); openK(); return;}
  if (k.hidden) return;
  if (e.key==="Escape") closeK();
  else if (e.key==="ArrowDown"){e.preventDefault(); kSel=Math.min(kSel+1,kRes.length-1); kDraw();}
  else if (e.key==="ArrowUp"){e.preventDefault(); kSel=Math.max(kSel-1,0); kDraw();}
  else if (e.key==="Enter") kGo();
});

const feat = $("#featured");
feat.innerHTML = ["silk-glass","product-360","liquid-chrome"].map(id=>cardHTML(C.find(c=>c.id===id))).join(""); mount(feat);
// old #/ links keep working
if (location.hash.startsWith("#/")) { const h=location.hash; history.replaceState(null,"",BASE+(h.startsWith("#/c/")?h.slice(4):h.startsWith("#/cat/")?"category/"+decodeURIComponent(h.slice(6)).toLowerCase():h.slice(2))); }
renderCats(); renderFilters(); renderGrid(); route();
}
