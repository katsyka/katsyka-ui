const C = [
  ["m-tabbar", "Liquid Glass Tab Bar", "Mobile", "A floating glass pill tab bar like YukiChat: a springy lens stretches between tabs like a drop of liquid, and the round search button beside it stretches into a full search field.", ["tab bar", "liquid glass", "navigation", "ios", "bottom nav"], 1],
  ["m-boarding-pass", "Boarding Pass", "Mobile", "A wallet-style boarding pass: airport codes large, times and gate in a tabular grid, a perforated tear line with notches, a scannable-looking code that brightens on tap, and a swipe to the return leg.", ["boarding pass", "ticket", "travel", "qr", "wallet"], 1],
  ["m-calendar", "Calendar Agenda", "Mobile", "A week strip you can swipe and tap, dots under days with events, and an agenda with a time rail, colour-coded event cards, a now line and an empty state for free days.", ["calendar", "agenda", "week", "events", "schedule"], 1],
  ["m-camera", "Camera", "Mobile", "A camera interface: viewfinder with grid and zoom chips, a mode strip you swipe or tap that snaps under a fixed marker, a shutter that flashes and drops the shot into the thumbnail, and flip / flash controls. Always dark, like real camera apps.", ["camera", "viewfinder", "shutter", "modes", "dark"], 1],
  ["m-cart", "Bag", "Mobile", "A shopping bag with quantity steppers that update every total live, remove that collapses the row, a promo code field and a checkout bar that always shows what you'll pay.", ["cart", "bag", "stepper", "checkout", "ecommerce"], 1],
  ["m-chat-list", "Chat List", "Mobile", "Messenger home: large title that hands off to the bar on scroll, filter chips, pinned chats, unread badges, typing state, and the glass pill with a search button that stretches open.", ["chat", "messenger", "list", "unread", "large title"], 1],
  ["m-chat-thread", "Chat Thread", "Mobile", "A conversation screen: glass header and composer floating over the messages, grouped bubbles with tails only on the last of a run, read ticks, a date chip and a mic button that turns into send as you type.", ["chat", "messages", "bubbles", "composer", "keyboard"], 1],
  ["m-checkout", "Checkout", "Mobile", "One-page mobile checkout: address card, delivery speed as large radio rows, saved payment methods, an order summary and a Pay button that loads into a success sheet.", ["checkout", "payment", "radio", "form", "success"], 1],
  ["m-collapsing-header", "Collapsing Header", "Mobile", "An album page whose cover stretches when you pull down, parallaxes as you scroll, and hands its title to a nav bar that fades in, with the play button pinned in place.", ["header", "parallax", "stretch", "collapsing", "album"], 1],
  ["m-compose", "Compose Sheet", "Mobile", "A card-style compose sheet over a scaled-back inbox: Cancel / Send header that only enables when there is a recipient and a body, recipient tokens you can add with return or comma and remove with backspace, and an auto-growing body.", ["compose", "email", "sheet", "tokens", "form"], 1],
  ["m-contacts", "Contacts Index", "Mobile", "A contacts list with sticky letter headers and an A–Z index on the edge: drag along it to scrub, a big letter bubble follows your thumb, and search filters as you type.", ["contacts", "index", "scrubber", "sticky headers", "list"], 1],
  ["m-files", "Files", "Mobile", "A file browser with a storage meter split by type, coloured folders, and recent files that switch between list and grid with a shared toggle. Type badges are colour plus text, never colour alone.", ["files", "storage", "folders", "grid", "list"], 1],
  ["m-food", "Restaurant Menu", "Mobile", "A restaurant page with sticky category tabs that follow your scroll and jump on tap, menu rows whose + turns into a stepper, and a basket bar that slides up with the count and total.", ["food", "delivery", "menu", "scrollspy", "stepper"], 1],
  ["m-gallery", "Photo Grid", "Mobile", "A photo library grid with Select mode: tap photos to tick them, the glass tab bar swaps for a Share / count / Delete toolbar, and outside Select a tap opens the photo full screen.", ["photos", "gallery", "grid", "select", "lightbox"], 1],
  ["m-habits", "Habit Tracker", "Mobile", "Daily habits as big tap targets: tap to complete with a check that draws in, a progress line for the day, streak flames, a week of dots per habit and a celebratory line when all are done.", ["habits", "tracker", "streak", "checklist", "progress"], 1],
  ["m-home-feed", "Social Feed", "Mobile", "A photo feed with a story rail (unseen rings, seen ones fade), post cards with double-tap to like, a save toggle and a glass tab bar.", ["feed", "social", "stories", "posts", "double tap"], 1],
  ["m-inbox", "Mail Inbox", "Mobile", "An inbox with real swipe gestures: drag a row left to reveal Archive (a full swipe archives it with Undo), right to toggle read. Unread rows are bold with a dot, stars toggle, and a compose button floats above the glass pill.", ["mail", "inbox", "swipe", "gesture", "undo"], 1],
  ["m-library", "Music Library", "Mobile", "A library home with the mini player docked above the glass tab bar: tap play without leaving the list, a hairline shows progress, and recently added albums sit in a two-column grid.", ["music", "library", "mini player", "list", "albums"], 1],
  ["m-long-press", "Long-press Menu", "Mobile", "Press and hold a message: the screen blurs, the bubble lifts toward you, a reaction bar appears above and a context menu below. Picking a reaction pins it to the bubble; Delete is set apart in red.", ["context menu", "long press", "reactions", "chat", "haptic"], 1],
  ["m-map-sheet", "Map with Bottom Sheet", "Mobile", "A full-screen map with a draggable bottom sheet that snaps to three detents by position and flick speed, a glass search bar on top, pins that select places in the list, and locate/layers buttons.", ["map", "bottom sheet", "detents", "drag", "places"], 1],
  ["m-news", "News Today", "Mobile", "A news front page: date-led header, a lead story with a big photo, section chips, and a story list with thumbs on the right, source, read time and a bookmark per story.", ["news", "feed", "articles", "editorial", "bookmark"], 1],
  ["m-notifications", "Activity Feed", "Mobile", "Notifications grouped by Today / This week with unread dots, bold names, photo thumbs or a Follow button, an All / Mentions switch and Mark all read.", ["notifications", "activity", "feed", "unread", "segmented"], 1],
  ["m-offline", "Offline State", "Mobile", "What a screen should do with no connection: a calm banner, cached content still readable with its age shown, actions that need the network disabled with a reason, and Retry that checks and recovers.", ["offline", "error", "empty state", "retry", "network"], 1],
  ["m-onboarding", "Onboarding", "Mobile", "Three swipeable intro pages with scroll-snap, a pager that stretches the active dot, Skip in the corner and one primary button in thumb reach that becomes Get started on the last page.", ["onboarding", "intro", "carousel", "pager", "swipe"], 1],
  ["m-order-track", "Order Tracking", "Mobile", "Live delivery tracking: the courier moves along the route on the map, the sheet shows a big ETA, a four-step progress line and call/message buttons for the courier.", ["delivery", "tracking", "map", "progress", "eta"], 1],
  ["m-otp", "Verification Code", "Mobile", "A six-digit code screen built on one real input with autocomplete=\"one-time-code\", so SMS autofill and paste work. Cells show the caret, it verifies on the last digit, shakes on a wrong code and counts down to Resend.", ["otp", "verification", "sms", "code", "autofill"], 1],
  ["m-paywall", "Paywall", "Mobile", "An honest subscription screen: what you get as a short list, yearly vs monthly as radio cards with the real per-month price, a trial button that says when you'll be charged, and Restore / Terms within reach.", ["paywall", "subscription", "pricing", "trial", "radio cards"], 1],
  ["m-permissions", "Permission Primer", "Mobile", "Ask for notifications the respectful way: a preview of the exact alerts you'll get, a clear reason, Turn on / Not now, and only then the system prompt. Declining is remembered, not punished.", ["permissions", "notifications", "onboarding", "primer", "system dialog"], 1],
  ["m-pin-lock", "Passcode Lock", "Mobile", "A lock screen passcode pad: round keys with letters, dots that fill as you type, a shake and a gentle message on a wrong code, Face ID and delete in the bottom corners, and an unlock that zooms through. The code is 1234.", ["passcode", "pin", "lock screen", "keypad", "security"], 1],
  ["m-player", "Now Playing", "Mobile", "A full-screen music player: artwork that shrinks back when paused, a draggable scrubber with tabular times, big transport controls in thumb reach, volume, and lyrics / output / queue at the bottom.", ["music", "player", "audio", "scrubber", "controls"], 1],
  ["m-podcast", "Podcast Episode", "Mobile", "An episode page: show artwork and title, a play button that shows time left and fills as it plays, a speed chip that cycles 1× to 2×, and chapters you can tap to jump with the current one highlighted.", ["podcast", "audio", "chapters", "episode", "speed"], 1],
  ["m-product", "Product Detail", "Mobile", "A product page with a swipeable gallery and page counter, glass back/save buttons over the photo, size and frame pickers, a collapsible description and an Add to bag bar that stays in thumb reach and updates the price.", ["ecommerce", "product", "gallery", "variant", "sticky cta"], 1],
  ["m-profile", "Profile", "Mobile", "A creator profile: centred avatar, tabular stats, a primary Follow that flips to Following, Message beside it, and a grid/saved switch with a sliding indicator over a three-column photo grid.", ["profile", "social", "stats", "grid", "follow"], 1],
  ["m-reader", "Article Reader", "Mobile", "A reading view: a hairline progress bar, a header that hides while you read down and returns when you scroll up, and an Aa panel with text size and Light / Sepia / Dark reading themes.", ["reader", "article", "typography", "progress", "reading"], 1],
  ["m-recipe", "Recipe", "Mobile", "A recipe page: hero photo, time / servings / difficulty, a servings stepper that rescales every ingredient, tick-off ingredients and numbered steps, with Start cooking in thumb reach.", ["recipe", "cooking", "stepper", "checklist", "steps"], 1],
  ["m-ride", "Ride Options", "Mobile", "Pick a ride over a live map: pickup and drop-off pills, ride types as big radio cards with ETA and price, a payment row and a confirm button that names your choice.", ["ride", "booking", "map", "radio cards", "transport"], 1],
  ["m-search", "Search", "Mobile", "A search screen that opens with the keyboard up: recent searches you can clear, trending topics, then live results grouped by type with the matched letters highlighted, and a clear empty state.", ["search", "results", "recent", "highlight", "keyboard"], 1],
  ["m-settings", "Settings", "Mobile", "Inset grouped settings: an account card, coloured icon tiles, real switches, values with chevrons and footnotes under groups. The large title folds into the bar as you scroll.", ["settings", "grouped list", "switch", "ios", "preferences"], 1],
  ["m-share-sheet", "Share & Action Sheets", "Mobile", "Two native-feeling sheets on one post: Share slides up with people, apps and actions and can be dragged down to dismiss; More opens a grouped action sheet with a separate Cancel and a destructive Report.", ["share sheet", "action sheet", "bottom sheet", "drag", "overlay"], 1],
  ["m-shop-home", "Shop Home", "Mobile", "A store front for a print shop: bag with a live count, search, a featured banner, category chips that filter, and a two-column product grid with save toggles and tabular prices.", ["ecommerce", "shop", "store", "grid", "products"], 1],
  ["m-signin", "Sign In", "Mobile", "Mobile sign-in that respects the keyboard: email and password with the right input types and autofill, a reveal toggle, a Continue button that waits for valid input then loads, plus passkey and social options.", ["auth", "login", "form", "passkey", "keyboard"], 1],
  ["m-snackbar", "Snackbar & FAB", "Mobile", "An extended floating action button that shrinks to an icon when you scroll down and grows back when you scroll up, plus snackbars for delete with Undo, a countdown line, and swipe-free auto-dismiss that waits while you're touching it.", ["snackbar", "fab", "undo", "toast", "material"], 1],
  ["m-stats", "Health Summary", "Mobile", "Activity rings that fill on load, metric tiles with a heart-rate sparkline, and a weekly bar chart where tapping a bar shows its value. Colours are retuned per theme, not just inverted.", ["health", "fitness", "rings", "chart", "dashboard"], 1],
  ["m-story", "Story Viewer", "Mobile", "Full-screen stories: segmented progress bars, tap the right side for next and left for back, press and hold to pause, a glass reply field with a like and send, and the next person's stories after the last one.", ["stories", "viewer", "tap zones", "progress", "social"], 1],
  ["m-todo", "To-do List", "Mobile", "A task list made for thumbs: add from a glass field at the bottom, tap the ring to complete (it moves to Done with a strike), drag the handle to reorder, and see the count per section.", ["todo", "tasks", "reorder", "drag", "checklist"], 1],
  ["m-transfer", "Send Money", "Mobile", "A transfer screen with its own keypad: big amount that scales down as it grows, decimal rules, a shake when you go over balance, a note field and a Send button that only wakes up for a valid amount.", ["payments", "keypad", "transfer", "amount", "finance"], 1],
  ["m-wallet", "Wallet", "Mobile", "A card wallet: tap a card in the stack to bring it forward, a tabular balance, four round quick actions and transactions grouped by day with signed amounts.", ["wallet", "bank", "cards", "transactions", "finance"], 1],
  ["m-weather", "Weather", "Mobile", "A weather screen with real hierarchy: a thin oversized temperature, an hourly strip, a 10-day list where each range bar sits on the week's scale, and detail tiles for UV, wind, humidity and sunset.", ["weather", "forecast", "hourly", "range bar", "tiles"], 1],
  ["m-wheel-picker", "Wheel Picker", "Mobile", "An alarm time picker built from scroll-snap columns with a 3D drum effect: hours, minutes and AM/PM. Flick or use arrow keys; the summary updates with time until the alarm.", ["picker", "wheel", "time", "scroll snap", "alarm"], 1],
  ["m-workout", "Interval Timer", "Mobile", "A workout interval timer: a big ring that drains per phase, a huge tabular countdown, work/rest colour that switches with the phase, round count, live heart rate and the next exercise up. Pause and skip sit low for thumbs.", ["workout", "timer", "interval", "fitness", "countdown"], 1],
  ["activity-feed", "Activity Feed", "Display", "A vertical activity timeline for a project: icon per event type, people, inline comment and file previews, relative times, and filter tabs for All / Comments / Changes.", ["timeline", "activity", "feed", "history", "comments"], 1],
  ["address-form", "Address Form", "Forms", "A shipping address form with the right autocomplete tokens, country-aware postcode label and pattern, errors on blur and on submit with a summary that links to each field, and a saved state.", ["form", "address", "validation", "autocomplete", "checkout"], 1],
  ["api-keys", "API Keys", "Data", "A developer settings table: masked keys with reveal and copy, scopes as badges, last-used times, a create flow that shows the new secret once, and revoke with a confirm step.", ["api", "keys", "developer", "table", "copy"], 1],
  ["attachments", "Attachments", "Display", "A list of attached files with a type badge, size, upload progress that you can cancel, a failed state with Retry, and remove. Add files with a button or by dropping them on the list.", ["files", "upload", "attachments", "progress", "list"], 1],
  ["callouts", "Callouts", "Feedback", "Inline callouts for docs and settings: Note, Tip, Warning and Danger, each with its own icon and title so meaning never depends on colour, optional action link and a dismiss button.", ["callout", "admonition", "alert", "docs", "note"], 1],
  ["color-swatches", "Color Swatches", "Forms", "A brand colour picker: swatches as a real radio group with arrow-key navigation, a check that flips to dark or light for contrast, a hex field that validates, and a live preview button.", ["color", "swatch", "picker", "radio", "theme"], 1],
  ["dark-accent-tuner", "Dark Accent Tuner", "Dark", "Pick a brand colour and get its dark-mode twin: OKLCH lightness raised and chroma lowered so it doesn't vibrate on dark surfaces, with live WCAG contrast for text and UI on every surface level, side by side with light mode.", ["dark mode", "color", "oklch", "contrast", "accessibility"], 1],
  ["dark-dashboard", "Dark Dashboard", "Dark", "A dark analytics view built by the rules: #0f0f11 base, surfaces stepped by lightness, off-white text, chart colours desaturated and lightened for dark, hairline borders, numbers in tabular figures and a hover crosshair on the chart.", ["dark mode", "dashboard", "chart", "analytics", "kpi"], 1],
  ["dark-elevation", "Dark Elevation", "Dark", "How depth works in dark UI: higher surfaces get lighter instead of relying on shadows, with a faint top highlight. A live stack (page, card, menu, dialog) plus a toggle that shows the naive black-and-shadow version for comparison.", ["dark mode", "elevation", "surfaces", "depth", "tokens"], 1],
  ["dark-pricing", "Dark Pricing", "Dark", "Pricing tiers on a dark page without neon: the featured plan is lifted by a lighter surface and a calm accent hairline, not a glow. Monthly/yearly switch with rolling prices, checks in muted green, and contrast-checked muted text.", ["dark mode", "pricing", "plans", "toggle", "saas"], 1],
  ["dark-type", "Dark Typography", "Dark", "The same article set naively (pure white on pure black, full-weight text, bright image, saturated link) and tuned (off-white on #121214, a touch lighter weight and more line height, dimmed photo, softened link). Drag the divider to compare.", ["dark mode", "typography", "reading", "contrast", "comparison"], 1],
  ["image-card", "Article Cards", "Cards", "A row of article cards: image with a slow zoom on hover, category, a two-line clamped title, excerpt, author and read time. The whole card is one link with a visible focus ring.", ["blog", "article", "card", "grid", "post"], 1],
  ["invoice", "Invoice", "Display", "A printable invoice: sender and client blocks, status badge, a line-item table with right-aligned tabular numbers, totals, payment details and Download / Print actions that hide when printing.", ["invoice", "billing", "table", "print", "document"], 1],
  ["marker-highlight", "Marker Highlight", "Text", "Key phrases in a paragraph get a highlighter stroke that draws left to right when the text scrolls into view, plus a hand-drawn underline and circle in SVG. Works across line breaks and keeps the text readable in both themes.", ["text effect", "highlight", "underline", "annotation", "scroll"], 1],
  ["mini-cart", "Mini Cart", "Overlays", "A header cart button with a live count badge that bumps on add, opening a dropdown cart: items with steppers, free-shipping progress, subtotal and Checkout. Closes on outside click and Escape, returns focus.", ["cart", "dropdown", "header", "ecommerce", "popover"], 1],
  ["notification-prefs", "Notification Preferences", "Forms", "A channels × events matrix: rows of events, columns for Email / Push / SMS, a column toggle that sets all, row descriptions, quiet hours with time inputs, and a sticky save bar that appears only when something changed.", ["settings", "notifications", "matrix", "checkbox", "preferences"], 1],
  ["order-summary", "Order Summary", "Cards", "A checkout summary card: line items with thumbnails, a promo code that validates, shipping choice, and totals that recalculate, ending in one clear Pay button.", ["checkout", "order", "cart", "totals", "ecommerce"], 1],
  ["plan-usage", "Plan & Usage", "Data", "A billing card: current plan with renewal date, usage meters that turn amber near the limit and red over it, with numbers in text so colour isn't the only signal, plus Upgrade and Manage actions.", ["billing", "plan", "usage", "meter", "subscription"], 1],
  ["quick-actions", "Quick Actions", "Cards", "A grid of quick-action tiles for a dashboard home: icon, label and hint per tile, a keyboard shortcut shown on hover, a \"New\" badge, and a pinned/unpinned state you can toggle.", ["dashboard", "actions", "shortcuts", "tiles", "grid"], 1],
  ["rating-summary", "Rating Summary", "Display", "A reviews block: average score with stars that show partial fill, a breakdown bar per star you can click to filter, and review cards with verified badges and Helpful counts.", ["reviews", "rating", "stars", "filter", "ecommerce"], 1],
  ["rolling-words", "Rolling Words", "Text", "One word in a sentence rolls like a slot reel to the next, while its box eases to the new word's width so the rest of the line glides instead of jumping. Pauses on hover and when the tab is hidden.", ["text effect", "rotating words", "slot", "headline", "width animation"], 1],
  ["search-field", "Search Field", "Forms", "A search input that does the details: ⌘K / Ctrl K to focus, a debounced spinner while results load, a listbox of suggestions with arrow keys and Enter, matched text in bold, recent searches, and a clear button.", ["search", "combobox", "autocomplete", "keyboard", "input"], 1],
  ["share-dialog", "Share Dialog", "Overlays", "A share modal: invite by email with a permission, people with access and their roles, general access (restricted vs anyone with the link), and Copy link with feedback. Focus is trapped and returns to the trigger.", ["share", "dialog", "modal", "permissions", "link"], 1],
  ["shimmer-text", "Shimmer Text", "Text", "A soft light sweep across status text while something works (\"Thinking\", \"Searching 12 sources\"), built with background-clip so it inherits your font and colour. Steps tick to done, then the shimmer stops.", ["text effect", "shimmer", "loading", "status", "ai"], 1],
  ["split-reveal", "Split Reveal", "Text", "Words rise out of a mask one after another when the block scrolls into view, with a 30 ms stagger and an ease-out that settles instead of bouncing. The text stays real, selectable text; reduced motion shows it at once.", ["text effect", "reveal", "stagger", "scroll", "intersection observer"], 1],
  ["stat-grid", "Stat Grid", "Data", "Four metric tiles with a period switch: tabular values, delta badges that use an arrow and sign as well as colour, and a small sparkline per tile.", ["stats", "kpi", "metrics", "dashboard", "sparkline"], 1],
  ["team-members", "Team Members", "Forms", "Manage a team: invite by email with a role, a members list with role selects (the last owner can't be demoted), pending invites you can resend or revoke, and remove with confirmation in place.", ["team", "members", "roles", "invite", "settings"], 1],
  ["text-scramble", "Text Scramble", "Text", "A headline that decodes from random glyphs into the real words, left to right, on load and again on hover or focus. Width is locked so nothing shifts, screen readers get the real text, and reduced motion skips straight to it.", ["text effect", "scramble", "decode", "headline", "hover"], 1],
  ["theme-switcher", "Theme Switcher", "Dark", "An appearance picker with Light / Dark / System preview cards. Picking one switches the whole page with a circular reveal from your click (View Transitions, crossfade fallback), sets color-scheme so form controls and scrollbars follow, and updates theme-color.", ["dark mode", "theme", "appearance", "view transition", "settings"], 1],
  ["toggle-group", "Toggle Groups", "Buttons", "Three everyday toggle groups in an editor toolbar: multi-select Bold / Italic / Underline, single-select text alignment as a radio group with arrow keys, and a view switch. Each shows pressed state with fill, not just colour.", ["toggle", "toolbar", "segmented", "radio", "editor"], 1],
  ["typewriter", "Typewriter", "Text", "A hero line that types and deletes a rotating phrase with a blinking caret, human-ish timing (slower on spaces, quick deletes), a pause on each word, and a stable line height. Screen readers hear the full sentence once.", ["text effect", "typewriter", "caret", "hero", "rotating"], 1],
  ["user-card", "User Card", "Cards", "A profile card: cover strip, avatar overlapping it, name with a verified mark, role, three tabular stats and Follow / Message actions where Follow flips to Following.", ["profile", "user", "card", "follow", "stats"], 1],
  ["dynamic-island", "Dynamic Island", "Custom", "A black pill that morphs between live activities: timer, call, upload progress. Tap the call to expand it; content crossfades with blur while the shape resizes.", ["morph", "live activity", "ios", "status"], 0],
  ["bookshelf", "Bookshelf", "Custom", "A shelf of book spines in varied widths and heights. Hover pulls a book out; click flies it forward into a cover-and-details card, and back again.", ["3d", "books", "shared element", "dialog"], 0],
  ["vinyl-deck", "Vinyl Deck", "Custom", "A turntable with a draggable tonearm: drop the needle to spin up the record, drag the record to scratch, switch 33/45. Progress follows the arm across the grooves.", ["music", "drag", "skeuomorphic", "player"], 0],
  ["pull-cord", "Pull-Cord Theme Switch", "Custom", "A lamp with a physics rope. Pull the cord past its stretch to switch light and dark mode; it rubber-bands and swings back. Keyboard press works too.", ["theme", "physics", "toggle", "dark mode"], 0],
  ["envelope-invite", "Envelope Invite", "Custom", "An envelope with a wax seal. Break it and the flap folds back, the invitation slides out, and RSVP buttons show pending and confirmed states.", ["invite", "rsvp", "3d", "reveal"], 0],
  ["polaroid-develop", "Polaroid Develop", "Custom", "Press the shutter, the print slides out of the camera and slowly develops from murky brown to full colour. Shake it to develop faster, then caption it.", ["photo", "camera", "drag", "playful"], 0],
  ["zipper-reveal", "Zipper Reveal", "Custom", "Drag a zipper down to part two fabric flaps and reveal hidden content, like a member code. Rubber-bands at both ends; arrow keys work.", ["reveal", "drag", "slider", "promo"], 0],
  ["sortable-list", "Sortable List", "Display", "Drag-to-reorder playlist: the row follows the pointer directly, the others slide out of the way, and the ends rubber-band. Full keyboard reordering with live announcements.", ["drag", "reorder", "list", "a11y"], 0],
  ["pull-refresh", "Pull to Refresh", "Feedback", "Mobile inbox with pull-to-refresh: diminishing resistance, an arc that fills as you pull, a spinner, then new messages stagger in at the top.", ["mobile", "refresh", "feed", "gesture"], 0],
  ["morph-subscribe", "Morphing Subscribe", "Forms", "A Subscribe button that grows into an email field, shrinks into a spinner, then turns into a drawn check. Inline validation, an error state that keeps your input, and Escape to cancel.", ["newsletter", "morph", "form", "async"], 0],
  ["felt-texture", "Felt Texture", "Backgrounds", "Pressed wool felt drawn in WebGL: thousands of tangled fibres, soft lumps and a light that follows the cursor across the nap.", ["webgl", "texture", "background", "felt"], 0],
  ["water-ripples", "Water Ripples", "Backgrounds", "Sunlit pool water seen from above: animated caustics, a sky-coloured surface and rings that spread wherever the cursor touches.", ["webgl", "water", "caustics", "background"], 0],
  ["speckled-graphite", "Speckled Graphite", "Backgrounds", "Dark graphite stone with mineral flecks at three sizes and a metallic sheen that slides as the cursor moves. Ideal behind dark product UI.", ["webgl", "stone", "texture", "background", "dark"], 0],
  ["grass-texture", "Grass Texture", "Backgrounds", "A dense lawn of individually drawn blades swaying in a wind field. The cursor parts the grass as it passes.", ["webgl", "nature", "grass", "background"], 0],
  ["dithered-image", "Dithered Image", "Backgrounds", "A photo rendered in two colours with an 8×8 Bayer ordered dither, the old-Mac way. The cursor opens a lens of real colour.", ["webgl", "dither", "photo", "retro", "background"], 0],
  ["paper-texture", "Paper Texture", "Backgrounds", "Heavy cotton paper with visible fibres, deckle grain and two soft folds, lit from the cursor so the surface catches the light.", ["webgl", "paper", "texture", "background", "light"], 0],
  ["cloud-sky", "Cloud Sky", "Backgrounds", "An endless drifting sky of soft cumulus, shaded towards a sun you move with the cursor. Never repeats.", ["webgl", "sky", "clouds", "background"], 0],
  ["lens-distortion", "Lens Distortion", "Backgrounds", "A photograph seen through drifting glass orbs. Each orb magnifies and bends the scene with a little chromatic fringe; one follows the cursor.", ["webgl", "lens", "glass", "photo", "background"], 0],
  ["stippled-gradient", "Stippled Gradient", "Backgrounds", "A slow, domain-warped gradient rendered as ink stipple on paper: every dot sized by the tone underneath, like a pen-and-ink engraving that moves.", ["webgl", "stipple", "gradient", "print", "background"], 0],
  ["square-dot-grid", "Square Dot Grid", "Backgrounds", "A field of tiny squares whose size follows interfering waves and a slow noise swell. They bloom and tint around the cursor.", ["webgl", "grid", "dots", "background", "generative"], 0],
  ["iridescent-shapes", "Iridescent Shapes", "Backgrounds", "Raymarched glossy shapes with a thin-film coating: colours shift through cyan, magenta and gold as the forms turn and as the cursor tilts them.", ["webgl", "3d", "iridescent", "raymarch", "background"], 0],
  ["impressionist-painting", "Impressionist Painting", "Backgrounds", "A landscape photo repainted live as thick oil brush strokes: each dab takes its colour from the scene, oriented along the image's edges, and slowly shimmers.", ["webgl", "painterly", "photo", "brush", "background"], 0],
